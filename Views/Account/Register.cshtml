@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["BodyClass"] = "register-page";
    ViewData["IncludeCsrf"] = false;
}

<div class="register-container">
    <div class="register-box">
        <h2>Create Your Account</h2>
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <input type="text" asp-for="Username" placeholder="Username" required>
            <input type="email" asp-for="Email" placeholder="Email" required>
            <div class="password-field">
                <input type="password" asp-for="Password" placeholder="Password" required>
                <button type="button" class="password-toggle" aria-label="Show password">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Username" class="text-danger"></span>
            <span asp-validation-for="Email" class="text-danger"></span>
            <button type="submit">Register</button>
        </form>
        <p><a asp-action="Login">Already have an account? Sign in</a></p>
    </div>
</div>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
