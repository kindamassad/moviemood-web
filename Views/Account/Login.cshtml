@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "login-page";
    ViewData["IncludeCsrf"] = false;
}

<div class="login-container">
    <div class="login-box">
        <h2>Login</h2>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="error">@Model.ErrorMessage</p>
        }
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="text" asp-for="Username" placeholder="Username" required>
            <div class="password-field">
                <input type="password" asp-for="Password" placeholder="Password" required>
                <button type="button" class="password-toggle" aria-label="Show password">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <button type="submit">Sign In</button>
        </form>
        <p><a asp-action="Register">New here? Create an account</a></p>
    </div>
</div>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
