@model ListViewModel
@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
<style>
    .list-view { padding-top: 120px; min-height: calc(100vh - 120px); }
    .filters-container { background-color: rgba(20, 20, 20, 0.95); padding: 25px; border-radius: 8px; margin-bottom: 30px; border: 1px solid rgba(255, 255, 255, 0.1); }
    .filter-label { display: block; margin-bottom: 8px; font-weight: 600; color: var(--mm-light); }
    .filter-select, .filter-input { width: 100%; padding: 10px 15px; background-color: rgba(30, 30, 30, 0.9); border: 1px solid rgba(255, 255, 255, 0.2); color: white; border-radius: 6px; }
    .movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .movie-card-container { position: relative; border-radius: 4px; overflow: hidden; transition: transform 0.3s; }
    .movie-card-container:hover { transform: scale(1.05); box-shadow: 0 5px 15px rgba(229, 9, 20, 0.4); }
    .movie-poster { width: 100%; height: 330px; object-fit: cover; }
    .pagination { display: flex; gap: 8px; justify-content: center; margin: 40px 0; }
    .page-link { color: white; background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: 600; }
    .page-item.active .page-link { background-color: var(--mm-red); border-color: var(--mm-red); }
</style>
}

<section class="container list-view">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@Model.Title</h1>
        <a asp-controller="Account" asp-action="Index" class="btn btn-outline-light"><i class="fas fa-arrow-left"></i> Back to Profile</a>
    </div>

    <form method="get" class="filters-container">
        <input type="hidden" name="list_type" value="@Model.ListType">
        @if (!string.IsNullOrEmpty(Model.ListName))
        {
            <input type="hidden" name="list_name" value="@Model.ListName">
        }
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="filter-label">Year From</label>
                <input type="number" name="year_from" class="filter-input" value="@Model.YearFrom">
            </div>
            <div class="col-md-3 mb-3">
                <label class="filter-label">Year To</label>
                <input type="number" name="year_to" class="filter-input" value="@Model.YearTo">
            </div>
            <div class="col-md-3 mb-3">
                <label class="filter-label">Genre</label>
                <select name="genre" class="filter-select">
                    <option value="">All Genres</option>
                    @foreach (var g in Model.Genres)
                    {
                        <option value="@g.Id" selected="@(Model.Genre == g.Id)">@g.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="filter-label">Sort By</label>
                <select name="sort_by" class="filter-select">
                    <option value="vote_average.desc" selected="@(Model.SortBy == "vote_average.desc")">Rating</option>
                    <option value="release_date.desc" selected="@(Model.SortBy == "release_date.desc")">Release Date</option>
                    <option value="original_title.asc" selected="@(Model.SortBy == "original_title.asc")">Title A-Z</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-danger">Apply Filters</button>
    </form>

    @if (Model.Movies.Count > 0)
    {
        <p class="text-muted mb-4">@Model.TotalResults movies in this list</p>
        <div class="movie-grid">
            @foreach (var movie in Model.Movies)
            {
                <div class="movie-card-container">
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">
                        <img src="@movie.PosterUrl" class="movie-poster" alt="@movie.Title">
                    </a>
                    <div class="movie-actions">
                        <button class="btn btn-outline-light btn-add-to-list" data-movie-id="@movie.Id"><i class="fas fa-plus"></i></button>
                        <button class="btn btn-outline-danger btn-add-to-favorites" data-movie-id="@movie.Id"><i class="fas fa-heart"></i></button>
                        <button class="btn btn-outline-danger btn-add-to-custom" data-movie-id="@movie.Id"><i class="fas fa-list"></i></button>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination">
                @for (var i = Model.StartPage; i <= Model.EndPage; i++)
                {
                    <span class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-list_type="@Model.ListType" asp-route-list_name="@Model.ListName"
                           asp-route-year_from="@Model.YearFrom" asp-route-year_to="@Model.YearTo"
                           asp-route-genre="@Model.Genre" asp-route-sort_by="@Model.SortBy" asp-route-page="@i">@i</a>
                    </span>
                }
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-film fa-3x mb-3" style="color: var(--mm-gray);"></i>
            <h3>No movies in this list</h3>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/script.js" asp-append-version="true"></script>
}
